{
  "name": "website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/optimize-images.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:a11y": "playwright test --project=light --project=dark",
    "test:browsers": "playwright test --project=chrome --project=firefox --project=safari --project=mobile-chrome --project=mobile-safari",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "d3-scale": "^4.0.2",
    "gray-matter": "^4.0.3",
    "marked": "^18.2.1",
    "next": "^16.4.6",
    "p5": "^1.11.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sass": "^1.104.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^20",
    "@types/p5": "^1.7.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.10.1",
    "serve": "^14.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
